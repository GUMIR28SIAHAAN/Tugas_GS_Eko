    // ============================================================
    // STATE & ELEMEN
    // ============================================================
    let userAnswers = new Array(questions.length).fill(null);
    let answered = new Array(questions.length).fill(false);
    let currentScore = 0;
    let quizStarted = false;

    const quizGrid = document.getElementById('quizGrid');
    const scoreDisplay = document.getElementById('scoreDisplay');
    const progressBar = document.getElementById('progressBar');
    const resultBanner = document.getElementById('resultBanner');
    const finalScore = document.getElementById('finalScore');
    const finalMessage = document.getElementById('finalMessage');
    const quizIntro = document.getElementById('quizIntro');
    const startQuizBtn = document.getElementById('startQuizBtn');
    const countdownBig = document.getElementById('countdownBig');

    const labels = ['A', 'B', 'C', 'D', 'E'];

    // ============================================================
    // INTRO SCREEN: COUNTDOWN 3-2-1
    // ============================================================
    function runCountdown() {
        let count = 3;
        countdownBig.innerHTML = `<span class="num">${count}</span>`;
        const interval = setInterval(() => {
            count--;
            if (count > 0) {
                countdownBig.innerHTML = `<span class="num">${count}</span>`;
            } else {
                clearInterval(interval);
                countdownBig.innerHTML = `<span class="num">🚀</span>`;
                startQuizBtn.disabled = false;
                startQuizBtn.textContent = '🚀 Mulai Kuis Sekarang!';
            }
        }, 1000);
    }

    function startQuiz() {
        quizIntro.classList.add('hidden');
        quizStarted = true;
        // Scroll ke grid kuis
        quizGrid.scrollIntoView({ behavior: 'smooth', block: 'start' });
        showToast('🚀', 'Selamat berjuang! Baca soal dengan teliti.');
    }

    // ============================================================
    // RENDER KUIS
    // ============================================================
    function renderQuiz() {
        quizGrid.innerHTML = '';
        questions.forEach((q, idx) => {
            const card = document.createElement('div');
            card.className = 'q-card';
            card.id = `qcard-${idx}`;

            const header = document.createElement('div');
            header.className = 'q-number';
            header.innerHTML = `<span>Soal ${idx + 1} dari ${questions.length}</span><span class="tag tag-${q.level.toLowerCase()}">${q.level}</span>`;

            const qText = document.createElement('div');
            qText.className = 'q-text';
            qText.textContent = `[${q.materi}] ${q.q}`;

            const optionsDiv = document.createElement('div');
            optionsDiv.className = 'options';

            q.opts.forEach((opt, oIdx) => {
                const btn = document.createElement('button');
                btn.className = 'option-btn';
                btn.dataset.qIdx = idx;
                btn.dataset.oIdx = oIdx;
                btn.innerHTML = `<span class="opt-label">${labels[oIdx]}.</span> <span>${opt}</span>`;
                btn.onclick = () => selectOption(idx, oIdx, btn);
                optionsDiv.appendChild(btn);
            });

            const feedback = document.createElement('div');
            feedback.className = 'feedback';
            feedback.id = `feedback-${idx}`;

            card.appendChild(header);
            card.appendChild(qText);
            card.appendChild(optionsDiv);
            card.appendChild(feedback);
            quizGrid.appendChild(card);
        });
    }

    // ============================================================
    // JAWABAN INTERAKTIF DENGAN FEEDBACK HIDUP
    // ============================================================
    function selectOption(qIdx, oIdx, btn) {
        if (answered[qIdx]) return;

        const card = document.getElementById(`qcard-${qIdx}`);
        card.querySelectorAll('.option-btn').forEach(b => b.classList.remove('selected'));
        btn.classList.add('selected');
        userAnswers[qIdx] = oIdx;
        answered[qIdx] = true;
        card.querySelectorAll('.option-btn').forEach(b => b.disabled = true);

        const correctIdx = questions[qIdx].ans;
        const feedback = document.getElementById(`feedback-${qIdx}`);
        const isCorrect = (oIdx === correctIdx);

        // Tandai benar/salah
        card.querySelectorAll('.option-btn').forEach((b, i) => {
            if (i === correctIdx) b.classList.add('correct');
            if (i === oIdx && !isCorrect) b.classList.add('wrong');
        });

        // Bangun feedback interaktif
        const emoji = isCorrect
            ? ['🎉', '🌟', '💪', '🔥', '👏'][Math.floor(Math.random() * 5)]
            : ['💡', '🔍', '📚', '🤔', '📝'][Math.floor(Math.random() * 5)];
        const headerText = isCorrect ? 'Benar sekali!' : 'Belum tepat, tapi jangan menyerah!';
        const badge = isCorrect ? 'SKOR +1' : 'SKOR +0';
        const nextHint = isCorrect
            ? 'Lanjut ke soal berikutnya! 🚀'
            : `Jawaban yang tepat: <strong>${labels[correctIdx]}</strong>. Baca pembahasannya, ya.`;

        feedback.className = `feedback show ${isCorrect ? 'ok' : 'no'}`;
        feedback.innerHTML = `
            <div class="feedback-inner">
                <div class="fb-header">
                    <span class="fb-emoji">${emoji}</span>
                    <span>${headerText}</span>
                </div>
                <div class="fb-explain">${questions[qIdx].explain}</div>
                <div class="fb-badge">${badge}</div>
                <div class="next-hint">${nextHint}</div>
            </div>
        `;

        // Toast + skor
        if (isCorrect) {
            currentScore++;
            scoreDisplay.textContent = currentScore;
            showToast(emoji, `+1 poin! Total skor: ${currentScore}`);
        } else {
            showToast(emoji, 'Tenang, pelajari pembahasannya!');
        }

        updateProgress();
    }

    function updateProgress() {
        const count = answered.filter(a => a).length;
        const pct = (count / questions.length) * 100;
        progressBar.style.width = pct + '%';
        if (count === questions.length) {
            showToast('🏁', 'Semua soal terjawab! Klik "Tampilkan Rekap" untuk melihat hasil.');
        }
    }

    // ============================================================
    // CEK SEMUA, REKAP, RESET
    // ============================================================
    function checkAllAnswers() {
        if (!quizStarted) {
            showToast('⏳', 'Klik "Mulai Kuis" dulu, ya!');
            return;
        }
        let unanswered = 0;
        questions.forEach((q, idx) => {
            if (!answered[idx]) {
                unanswered++;
                const card = document.getElementById(`qcard-${idx}`);
                card.querySelectorAll('.option-btn').forEach(b => {
                    if (parseInt(b.dataset.oIdx) === q.ans) b.classList.add('correct');
                    b.disabled = true;
                });
                const feedback = document.getElementById(`feedback-${idx}`);
                feedback.className = 'feedback show no';
                feedback.innerHTML = `
                    <div class="feedback-inner">
                        <div class="fb-header">
                            <span class="fb-emoji">⚠️</span>
                            <span>Belum dijawab</span>
                        </div>
                        <div class="fb-explain">Jawaban benar: <strong>${labels[q.ans]}</strong>. ${q.explain}</div>
                        <div class="fb-badge">SKOR +0</div>
                    </div>
                `;
                answered[idx] = true;
            }
        });
        updateProgress();
        showToast(unanswered > 0 ? '⚠️' : '✅',
            unanswered > 0 ? `${unanswered} soal belum dijawab. Semua kunci sudah ditampilkan.` : 'Semua soal sudah dijawab. Klik "Tampilkan Rekap".');
    }

    function showSummary() {
        const total = questions.length;
        const correct = userAnswers.reduce((acc, ans, idx) => acc + (ans === questions[idx].ans ? 1 : 0), 0);
        const pct = Math.round((correct / total) * 100);

        finalScore.textContent = `${correct} / ${total}`;
        let msg = '';
        let emoji = '';
        if (pct >= 90) { msg = 'Luar biasa! Kamu siap menghadapi AAS Ganjil!'; emoji = '🏆'; }
        else if (pct >= 75) { msg = 'Bagus! Sedikit lagi menuju sempurna.'; emoji = '💪'; }
        else if (pct >= 60) { msg = 'Cukup baik. Pelajari kembali materi yang masih lemah.'; emoji = '📚'; }
        else { msg = 'Jangan menyerah! Ayo ulangi kuis dan pelajari pembahasannya.'; emoji = '🔄'; }

        finalMessage.textContent = `${emoji} ${msg} (Nilai: ${pct})`;
        resultBanner.classList.add('show');
        resultBanner.scrollIntoView({ behavior: 'smooth', block: 'center' });
        showToast(emoji, `Skor akhir: ${correct}/${total} (Nilai ${pct})`);
    }

    function resetQuiz() {
        userAnswers = new Array(questions.length).fill(null);
        answered = new Array(questions.length).fill(false);
        currentScore = 0;
        scoreDisplay.textContent = '0';
        progressBar.style.width = '0%';
        resultBanner.classList.remove('show');
        quizIntro.classList.remove('hidden');
        startQuizBtn.disabled = true;
        startQuizBtn.textContent = '⏳ Bersiap…';
        quizStarted = false;
        renderQuiz();
        runCountdown();
        showToast('🔄', 'Kuis direset. Siap main lagi!');
        quizIntro.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    // ============================================================
    // TOAST NOTIFIKASI
    // ============================================================
    let toastTimeout = null;
    function showToast(emoji, msg) {
        const toast = document.getElementById('toast');
        document.getElementById('toastEmoji').textContent = emoji;
        document.getElementById('toastMsg').textContent = msg;
        toast.classList.add('show');
        if (toastTimeout) clearTimeout(toastTimeout);
        toastTimeout = setTimeout(() => toast.classList.remove('show'), 2600);
    }

    // ============================================================
    // INISIALISASI
    // ============================================================
    renderQuiz();
    runCountdown();
</script>

